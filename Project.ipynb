    "#here is the implementation of the AI optimization, using the binary idea:\n",
    "\n",
    "def knapdynMem_BIN(values, weights, quantities, capacity):\n",
    "    \n",
    "    bin_values = []\n",
    "    bin_weights = []\n",
    "\n",
    "    for v, w, q in zip(values, weights, quantities):\n",
    "        k = 1\n",
    "        while q > 0:\n",
    "            take = min(k, q)\n",
    "            bin_values.append(take * v)\n",
    "            bin_weights.append(take * w)\n",
    "            q -= take\n",
    "            k *= 2\n",
    "\n",
    "\n",
    "    dico = {}\n",
    "\n",
    "    def true_recurse(capacity, i):\n",
    "        key = (i, capacity)\n",
    "        if key in dico:\n",
    "            return dico[key]\n",
    "\n",
    "        if i < 0 or capacity == 0:\n",
    "            dico[key] = 0\n",
    "            return 0\n",
    "\n",
    "        c_val = bin_values[i]\n",
    "        c_w = bin_weights[i]\n",
    "\n",
    "        best = true_recurse(capacity, i - 1)\n",
    "\n",
    "        if c_w <= capacity:\n",
    "            take_val = c_val + true_recurse(capacity - c_w, i - 1)\n",
    "            best = max(best, take_val)\n",
    "\n",
    "        dico[key] = best\n",
    "        return best\n",
    "\n",
    "    return true_recurse(capacity, len(bin_values) - 1)"
   ]
  },
