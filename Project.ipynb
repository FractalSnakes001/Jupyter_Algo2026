    "**Q2.** Write a recursive function `knapdyn(values, weights, quantities, capacity)` implementing the previous recurrence, without memoization, and returning the maximum value of a bounded knapsack problem."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 42,
   "id": "6176ea7e",
   "metadata": {},
   "outputs": [],
   "source": [
    "#it says not to use memoization, at first i implemented a bottom-up approach without thinking, but that is not a recursive function....\n",
    "#i have left it here to later test the speeds, renamed to knapdyn_bottom_up.\n",
    "\n",
    "#i will code the items starting at 0 because arrays.\n",
    "\n",
    "def knapdyn_bottom_up(values, weights, quantities, capacity):\n",
    "    n = len(values)\n",
    "    #we need a 2D array for items and capacity, \n",
    "    # with Array[i][w] = max value for w and only using items 0 to i-1 \n",
    "    Array = [[0 for _ in range(capacity + 1)] for _ in range(n + 1)]\n",
    "\n",
    "    for i in range(n):\n",
    "        for w in range(capacity + 1):\n",
    "            #Max items i we can fit into w\n",
    "            if weights[i] <= w:\n",
    "                #i assume c_w will never be 0 since we said w_i are positive integer numbers at the start.\n",
    "                max_count = min(quantities[i], w // weights[i])\n",
    "            else:\n",
    "                max_count = 0\n",
    "\n",
    "            # Find the best value\n",
    "            max_value = 0\n",
    "            for q in range(max_count + 1):\n",
    "                total_value = Array[i][w - q * weights[i]] + q*values[i]\n",
    "                if total_value > max_value:\n",
    "                    max_value = total_value\n",
    "            Array[i + 1][w] = max_value\n",
    "\n",
    "    return Array[n][capacity]\n",
    "\n",
    "\n",
    "\n",
    "#the actual function that was asked for: \n",
    "#base case are 0, and looking at the bottom up implementation i can catch the case where\n",
    "#the item cannot fit at all, and skip it. So it was not a full waste of time \n",
    "\n",
    "\n",
    "#i had a problem, i don't want to use array[:-1] since it creates new arrays. so i used 'i' as an argument but\n",
    "#then the user could touch the value i while calling the function and breaking it so i made a second hidden function inside.\n",
    "\n",
    "\n",
    "def knapdyn(values, weights, quantities, capacity):\n",
    "    #since defined inside the values, weights and quantites are known.\n",
    "    def true_recurse(capacity, i):\n",
    "        \n",
    "        # Base case: no items left or no capacity\n",
    "        if i < 0 or capacity == 0:\n",
    "            return 0\n",
    "\n",
    "        #Current item, we are working on the last item on the list generally\n",
    "        c_val = values[i]\n",
    "        c_w = weights[i]\n",
    "        c_q = quantities[i]\n",
    "\n",
    "        #If the item does not fit, skip! \n",
    "        if c_w > capacity:\n",
    "            return true_recurse(capacity, i - 1)\n",
    "\n",
    "        #if it fits we do the same as the bottom up: we loop on the possible quantities \n",
    "        max_value = 0\n",
    "        #i assume c_w will never be 0 since we said w_i are positive integer numbers at the start.\n",
    "        max_count = min(c_q, capacity // c_w)\n",
    "\n",
    "        for q in range(max_count + 1):  \n",
    "            next_capacity = capacity - q * c_w\n",
    "\n",
    "            #recurse call for the remaining capacity= W - q*c_w and we use the remaining items (cutting the last item = current item)\n",
    "            recurse_bestvalue = true_recurse(next_capacity, i - 1)\n",
    "            total_value = q * c_val + recurse_bestvalue\n",
    "\n",
    "            max_value = max(max_value, total_value)\n",
    "\n",
    "        return max_value\n",
    "\n",
    "    #i call the \"protected function\"\n",
    "    return true_recurse(capacity,len(values)-1)"
   ]
